{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AiDirector": {
    "AppName": "AI Director",
    "AutoResume": false,
    "Paths": {
      "Database": "../../../ai_director.db",
      "AssetsDir": "../../../assets_generated",
      "ProjectsDir": "../../../projects",
      "ChannelsDir": "../../../channels",
      "FfmpegBin": "ffmpeg",
      "FfprobeBin": "ffprobe"
    },
    "ComfyUi": {
      "BaseUrl": "http://127.0.0.1:8188",
      "AutoLaunch": true
    }
  },
  "AllowedHosts": "*"
}
